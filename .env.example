# 使用方式：复制本文件为 .env，填入真实 API Key
#   cp .env.example .env

# ===== 阿里云百炼（DashScope）OpenAI 兼容模式 =====
# API Key 获取：https://bailian.console.aliyun.com/ → 右上角「API-KEY」→ 创建
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# 服务端点（按地域二选一）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 模型：代码内置兜底 qwen3.7-plus，未配置时会**告警回退**（不静默）。
# 请用「带日期的快照名」而非浮动别名（如 qwen-plus），否则同一份报告无法复现。
# ⚠️ 但快照名有生命周期：旧快照会被平台下线（本项目实测：qwen-plus-2025-07-28 →
#    404 Model not exist）。所以**可复现性是有保质期的** —— 引用报告前先确认该快照仍在线。
# 换模型 → 历史指标不可比，引用必须带模型名 + 日期。
# ⚠️ 快照名的免费额度是**按模型 ID 分桶**的：qwen3.7-plus-2026-05-26 的 100 万 Token
#    已于 2026-10-12 18:08 耗尽（403 Free quota exhausted），而浮动别名 qwen3.7-plus 仍可用。
#    两者额度不通用 —— 快照挂了不代表别名挂了，反之亦然。
# 🔴 2026-10-26 全池实测：qwen3.5-plus / qwen3.6-plus / qwen3.6-flash 均已 403 耗尽，
#    带日期快照 qwen3.5-plus-2026-02-15 早已 dead —— **快照全灭，只剩别名的路**。
#    W2 的 60/60 属「qwen3.5-plus 时代」，换 qwen3.7-plus 后不可直接比较，
#    须先重跑一次 52 题基线（见 docs/过程记录/W2-收尾审计-20261026.md 第六节）。
LLM_MODEL=qwen3.7-plus
